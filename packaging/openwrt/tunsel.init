#!/bin/sh /etc/rc.common
# procd service, installed by the package as /etc/init.d/tunsel (DESIGN.md §9.2).

USE_PROCD=1
START=90
STOP=10

PROG=/usr/sbin/tunsel
CONFIG=/etc/config/tunsel

# The daemon ignores "enabled"; it only decides whether the service is
# enabled and runs.
uci_enabled() {
	local enabled
	config_load tunsel
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ]
}

start_service() {
	# Installed but not configured yet: nothing to run.
	if ! uci_enabled; then
		echo "tunsel: disabled, not started (set tunsel.main.enabled=1 in $CONFIG or in LuCI)" >&2
		return 0
	fi
	"$PROG" check -config "$CONFIG" >/dev/null || return 1

	procd_open_instance
	procd_set_param command "$PROG" run -config "$CONFIG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Room for a clean shutdown (cleanup_on_exit) before SIGKILL.
	procd_set_param term_timeout 10
	procd_close_instance
}

# `uci commit tunsel` (LuCI's Save & Apply) runs reload.
service_triggers() {
	procd_add_reload_trigger tunsel
}

# Follows "enabled": disabled also takes the service out of the boot
# sequence (and procd drops the reload trigger with it, so LuCI enables and
# starts it again explicitly); enabled puts it back.
reload_service() {
	if ! uci_enabled; then
		disable
		stop
		return 0
	fi
	enable
	# The daemon keeps its configuration on an invalid reload; checking here
	# also reports the error to the caller, not only to the log.
	"$PROG" check -config "$CONFIG" >/dev/null || return 1
	if procd_running tunsel; then
		procd_send_signal tunsel
	else
		start
	fi
}
