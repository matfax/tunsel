#!/bin/sh /etc/rc.common
# procd service, installed by the package as /etc/init.d/tunsel (DESIGN.md §9.2).

USE_PROCD=1
START=90
STOP=10

PROG=/usr/sbin/tunsel
CONFIG=/etc/tunsel/config.yaml

start_service() {
	# Installed but not configured yet: nothing to run.
	if [ ! -f "$CONFIG" ]; then
		echo "tunsel: $CONFIG missing, not started (see /etc/tunsel/config.example.yaml)" >&2
		return 0
	fi
	"$PROG" check -config "$CONFIG" >/dev/null || return 1

	procd_open_instance
	procd_set_param command "$PROG" run -config "$CONFIG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Room for a clean shutdown (cleanup_on_exit) before SIGKILL.
	procd_set_param term_timeout 10
	procd_close_instance
}

reload_service() {
	# The daemon keeps its configuration on an invalid reload; checking here
	# also reports the error to the caller, not only to the log.
	"$PROG" check -config "$CONFIG" >/dev/null || return 1
	procd_send_signal tunsel
}
