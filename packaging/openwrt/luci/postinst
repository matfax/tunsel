#!/bin/sh
# Makes rpcd load the new ACL and plugin and LuCI rebuild its menu (as
# packages built with luci.mk do). On Turris OS 9 the plugin is still not
# on ubus after the SIGHUP; rpcd is restarted then, which ends LuCI logins.
[ -n "${IPKG_INSTROOT}" ] && exit 0
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache/
killall -HUP rpcd 2>/dev/null
i=0
until ubus list tunsel >/dev/null 2>&1; do
	i=$((i+1))
	if [ $i -ge 10 ]; then
		echo "luci-app-tunsel: rpcd did not load its plugin on SIGHUP; restarting rpcd (log in to LuCI again)" >&2
		/etc/init.d/rpcd restart
		break
	fi
	sleep 1
done
exit 0
