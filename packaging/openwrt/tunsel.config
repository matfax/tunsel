# tunsel configuration (UCI), installed as /etc/config/tunsel.
# Same settings as config.example.yaml; all values are placeholders
# (documentation address ranges, generic names). Edit them here or in LuCI
# (Services → tunsel), then set enabled to 1. UCI tools rewrite this file
# without its comments; config.example.yaml documents the same options.
# The host must provide, per tunnel: a routing table with a default route via
# the tunnel, and a rule "fwmark <mark>/<mark_mask> lookup <table>".

config tunsel 'main'
	option enabled '0'
	# tool-owned nftables table (family inet)
	option table 'tunsel'
	# only these mark bits are read/written
	option mark_mask '0xf'
	# remove the table on clean shutdown
	option cleanup_on_exit '0'
	# First healthy tunnel wins for traffic without a static match.
	list default_order 'wg-b'
	list default_order 'wg-a'
	# only traffic entering here is steered
	list ingress 'lan0'
	# also steer the host's own traffic
	option include_local_output '0'
	# Never marked (e.g. tunnel endpoints, local/private ranges).
	list exclude '192.0.2.10/32'
	list exclude '198.51.100.20/32'
	list exclude '10.0.0.0/8'
	list exclude '172.16.0.0/12'
	list exclude '192.168.0.0/16'
	list exclude 'fc00::/7'
	list exclude 'fe80::/10'
	# delete a failed tunnel's flows so they are re-decided
	option flush_on_unhealthy '1'
	# Per-destination selection by measured latency. Phase 2: not
	# implemented yet, so learning must stay 0; the values are the defaults.
	option learning '0'
	# busiest destinations without a learned entry
	option learn_source 'conntrack'
	# destinations measured per refresh
	option learn_top_n '100'
	option learn_refresh '5m'
	# TCP handshake time via each healthy tunnel
	option learn_port '443'
	# per tunnel; the median counts
	option learn_samples '3'
	option learn_timeout '2s'
	# switch only if the winner is faster by both
	option learn_min_gain_abs '5ms'
	option learn_min_gain_rel '15%'
	# lifetime of a learned entry
	option learn_ttl '1h'
	# at most this many changes per destination within the window
	option learn_damp_window '30m'
	option learn_damp_max_switches '2'
	# debug | info | warn | error
	option log_level 'info'
	# text | json
	option log_format 'text'
	option socket '/run/tunsel/tunsel.sock'

config tunnel 'wg_a'
	# interface name
	option iface 'wg-a'
	option mark '0x1'
	# families the tunnel carries (default: both)
	list family 'ipv4'
	list family 'ipv6'
	list target '192.0.2.1'
	list target '198.51.100.1'
	# icmp | tcp:<port>
	option probe 'icmp'
	option interval '10s'
	option timeout '2s'
	# targets that must answer for a round to pass
	option min_ok '1'
	# consecutive failed rounds → unhealthy
	option fail_after '3'
	# consecutive passed rounds → healthy
	option recover_after '3'
	# Fixed preferences, applied only while the tunnel is healthy.
	list prefer '203.0.113.0/24'
	list prefer '2001:db8:100::/48'

config tunnel 'wg_b'
	option iface 'wg-b'
	option mark '0x2'
	list target '203.0.113.1'
	list target '198.51.100.2'
	option probe 'icmp'
	option interval '10s'
	option timeout '2s'
	option min_ok '1'
	option fail_after '3'
	option recover_after '3'
